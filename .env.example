PORT=3000
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_VAULT_CONTRACT_ID=vault.rimbux.testnet
NEAR_AGENT_ACCOUNT_ID=agent.rimbux.testnet

# Leave empty to run in read-only mode (everything simulated, no login needed for the demo).
NEAR_AGENT_FUNCTION_CALL_PRIVATE_KEY=

# At least 64 characters. Generate with: openssl rand -hex 48
RIMBUX_AUDIT_SECRET=

# Operator login hash. Generate with the command in the README ("Operator login").
RIMBUX_OPERATOR_PASSWORD_HASH=

# Optional: operator session length in hours (1-24, default 8)
RIMBUX_SESSION_TTL_HOURS=8

# Real NEAR Testnet broadcasting is disabled by default
RIMBUX_BROADCAST=false
