// src/near/signingBoundary.ts
import crypto from "crypto";
import { KeyPair } from "near-api-js";
import { ExtractedTransactionIntent, PolicyAuthorizationToken, TransactionLifecycleStatus } from "../types";
import { DeterministicPolicyEngine } from "../security/policyEngine";

export interface SandboxKeyMetadata {
  publicKey: string;
  permissionScope: "FunctionCall";
  receiverContractId: string;
  allowedMethods: string[];
  gasAllowanceNear: number;
  canTransferNativeNearDirectly: false;
  canDeployContracts: false;
  canModifyAccessKeys: false;
  revoked: boolean;
}

export interface SignedTransactionEnvelope {
  lifecycleStatus: TransactionLifecycleStatus;
  signerAccountId: string;
  signerPublicKey: string;
  receiverContractId: string;
  methodName: string;
  args: {
    recipientId: string;
    amountYocto: string;
    intentNonce: string;
    purposeDigest: string;
  };
  gasTgas: number;
  attachedDepositYocto: "0";
  unsignedPayloadDigest: string;
  ed25519SignatureBase64: string;
  txHash: string;
  explorerUrl?: string;
  verificationNote: string;
}

export class SandboxedSigningBoundary {
  private keyPair: KeyPair;
  private revoked: boolean = false;
  private readonly agentAccountId: string;
  private readonly vaultContractId: string;
  private readonly allowedMethods: string[] = ["execute_agent_payment"];
  private readonly gasAllowanceNear: number = 0.25;

  constructor(agentAccountId: string, vaultContractId: string, privateKeyEnv?: string) {
    this.agentAccountId = agentAccountId;
    this.vaultContractId = vaultContractId;
    if (privateKeyEnv && privateKeyEnv.startsWith("ed25519:")) {
      this.keyPair = KeyPair.fromString(privateKeyEnv as any);
    } else {
      this.keyPair = KeyPair.fromRandom("ed25519");
    }
  }

  public getPublicMetadata(): SandboxKeyMetadata {
    return {
      publicKey: this.keyPair.getPublicKey().toString(),
      permissionScope: "FunctionCall",
      receiverContractId: this.vaultContractId,
      allowedMethods: [...this.allowedMethods],
      gasAllowanceNear: this.gasAllowanceNear,
      canTransferNativeNearDirectly: false,
      canDeployContracts: false,
      canModifyAccessKeys: false,
      revoked: this.revoked,
    };
  }

  public revokeKey(): void {
    this.revoked = true;
  }

  public rotateSandboxKey(): SandboxKeyMetadata {
    this.keyPair = KeyPair.fromRandom("ed25519");
    this.revoked = false;
    return this.getPublicMetadata();
  }

  public signAuthorizedVaultIntent(
    intent: ExtractedTransactionIntent,
    authToken: PolicyAuthorizationToken | undefined,
    policyEngine: DeterministicPolicyEngine
  ): SignedTransactionEnvelope {
    if (this.revoked) {
      throw new Error("SANDBOX_KEY_REVOKED: FunctionCall access key milik agen AI telah dicabut oleh operator.");
    }

    const methodName = intent.contractMethod || "execute_agent_payment";

    if (!this.allowedMethods.includes(methodName)) {
      throw new Error(
        `SANDBOX_BOUNDARY_VIOLATION: FunctionCall key dibatasi hanya untuk [${this.allowedMethods.join(
          ", "
        )}]; menolak menandatangani '${methodName}'.`
      );
    }

    const tokenVerification = policyEngine.verifyAndConsumeToken(
      authToken,
      intent.intentId,
      intent.recipientId,
      intent.amountYocto,
      methodName
    );

    if (!tokenVerification.valid) {
      throw new Error(`UNAUTHORIZED_SIGNING_ATTEMPT: ${tokenVerification.reason}`);
    }

    const purposeDigest = crypto.createHash("sha256").update(intent.rawInstruction).digest("hex");
    const args = {
      recipientId: intent.recipientId,
      amountYocto: intent.amountYocto,
      intentNonce: intent.intentId,
      purposeDigest,
    };

    const canonicalUnsignedTx = JSON.stringify({
      signerId: this.agentAccountId,
      publicKey: this.keyPair.getPublicKey().toString(),
      receiverId: this.vaultContractId,
      action: {
        type: "FunctionCall",
        methodName,
        args,
        gas: "30000000000000",
        deposit: "0",
      },
    });

    const unsignedBuffer = Buffer.from(canonicalUnsignedTx, "utf-8");
    const unsignedPayloadDigest = crypto.createHash("sha256").update(unsignedBuffer).digest("hex");

    const signature = this.keyPair.sign(unsignedBuffer);
    const ed25519SignatureBase64 = Buffer.from(signature.signature).toString("base64");
    const txHash = `near_tx_${unsignedPayloadDigest.slice(0, 24)}`;

    return {
      lifecycleStatus: "SIGNED",
      signerAccountId: this.agentAccountId,
      signerPublicKey: this.keyPair.getPublicKey().toString(),
      receiverContractId: this.vaultContractId,
      methodName,
      args,
      gasTgas: 30,
      attachedDepositYocto: "0",
      unsignedPayloadDigest,
      ed25519SignatureBase64,
      txHash,
      explorerUrl: `https://testnet.nearblocks.io/txns/${txHash}`,
      verificationNote:
        "Ditandatangani di dalam batas Ed25519 FunctionCall terisolasi (receiver: rimbux-vault.testnet, deposit: 0, method: execute_agent_payment). Status dibedakan secara tegas sebagai SIGNED (belum CONFIRMED_ONCHAIN hingga dibroadcast dengan kunci Testnet aktif).",
    };
  }
}